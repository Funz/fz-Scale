' Godiva (HEU-MET-FAST-001): bare HEU sphere, critical radius 8.741 cm
' r = &(r~8.741) cm, mass = @{round(4/3*3.14159265*r**3*18.742/1000, 2)} kg
=csas6-shift
godiva bare HEU sphere
ce_v7.1
read composition
 uranium 1 den=18.742 1 293 92234 1.0202 92235 93.7112 92238 5.2686 end
end composition
read parameters
 gen=250 npg=2000 nsk=50
end parameters
read geometry
global unit 1
 sphere 10 &(r)
 media 1 1 10
 boundary 10
end geometry
end data
end
